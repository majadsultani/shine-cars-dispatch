generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id            String    @id @default(cuid())
  name          String
  phone         String
  pickup        String
  dropoff       String
  date          String
  time          String
  distance      Float
  fare          Float
  vehicle       String    @default("car")
  status        String    @default("pending")
  source        String    @default("website")
  paymentMethod String    @default("cash")
  paymentStatus String    @default("unpaid")
  driverId      String?
  customerId    String?
  assignedAt    DateTime?
  fareType      String    @default("fixed")
  meterDistance Float?
  meterFare     Float?
  cashCollected Float?
  stops         String?
  notes         String?
  pickupDetails  String?
  dropoffDetails String?
  buildingInfo   String?
  eventPricingId String?
  eventSurcharge Float?
  waitingCharge    Float?
  waitingSeconds   Int?
  extraChargeNote  String?
  isPriority    Boolean   @default(false)
  priorityCharge Float?
  isRecurring   Boolean   @default(false)
  recurringId   String?
  isOpenBid     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  driver        Driver?   @relation(fields: [driverId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  recurring     RecurringBooking? @relation(fields: [recurringId], references: [id])
  invoiceItems        InvoiceItem[]
  driverInvoiceItems  DriverInvoiceItem[]
  bids                Bid[]

  @@index([status])
  @@index([createdAt])
  @@index([driverId])
  @@index([customerId])
  @@index([recurringId])
  @@index([isOpenBid, status])
}

model Operator {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("operator")
  createdAt DateTime @default(now())
}

model Driver {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  phone             String
  password          String
  status            String    @default("pending")
  isAvailable       Boolean   @default(false)
  isEnabled         Boolean   @default(true)
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?
  vehicleMake       String?
  vehicleColor      String?
  vehicleReg        String?
  passengerLicense  Int?
  commissionRate    Float     @default(20)
  pushToken         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  documents         DriverDocument[]
  bookings          Booking[]
  bids              Bid[]
  recurringBookings RecurringBooking[]
  notifications     DriverNotification[]
  chatMessages      ChatMessage[]
  driverInvoices    DriverInvoice[]
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  phone       String
  password    String
  accountType String    @default("individual")
  companyName String?
  pushToken   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  recurringBookings RecurringBooking[]
  invoices    Invoice[]

  @@index([accountType])
}

model RecurringBooking {
  id         String   @id @default(cuid())
  customerId String
  driverId   String?
  pickup     String
  dropoff    String
  stops      String?
  time       String
  vehicle    String   @default("car")
  fare       Float
  distance   Float
  days       String
  frequency  String   @default("weekly")
  startDate  String?
  endDate    String?
  name       String
  phone      String
  isActive     Boolean  @default(true)
  driverStatus String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id])
  driver       Driver?  @relation(fields: [driverId], references: [id])
  bookings     Booking[]

  @@index([customerId])
  @@index([driverId])
  @@index([isActive])
}

model Invoice {
  id         String   @id @default(cuid())
  customerId String
  weekStart  String
  weekEnd    String
  total      Float    @default(0)
  status     String   @default("unpaid")
  stripeId   String?
  paidAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
  items      InvoiceItem[]

  @@unique([customerId, weekStart])
  @@index([customerId])
  @@index([status])
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  bookingId String
  fare      Float
  date      String
  pickup    String
  dropoff   String
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  booking   Booking  @relation(fields: [bookingId], references: [id])

  @@index([invoiceId])
  @@index([bookingId])
}

model DriverInvoice {
  id               String    @id @default(cuid())
  driverId         String
  weekStart        String
  weekEnd          String
  totalFares       Float     @default(0)
  commissionRate   Float     @default(20)
  commissionAmount Float     @default(0)
  licenceFee       Float     @default(0)
  otherCharges     Float     @default(0)
  otherChargesNote String?
  netPayable       Float     @default(0)
  status           String    @default("unpaid")
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  driver           Driver    @relation(fields: [driverId], references: [id])
  items            DriverInvoiceItem[]

  @@unique([driverId, weekStart])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}

model DriverInvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  bookingId String
  fare      Float
  date      String
  pickup    String
  dropoff   String
  createdAt DateTime @default(now())
  invoice   DriverInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  booking   Booking       @relation(fields: [bookingId], references: [id])

  @@index([invoiceId])
  @@index([bookingId])
}

model DriverNotification {
  id        String   @id @default(cuid())
  driverId  String
  title     String
  body      String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id])

  @@index([driverId, isRead])
  @@index([createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  driverId  String
  message   String
  sender    String   // "driver" or "dispatcher"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id])

  @@index([driverId, createdAt])
  @@index([driverId, isRead])
}

model DriverDocument {
  id         String   @id @default(cuid())
  driverId   String
  type       String
  fileUrl    String
  expiryDate String
  createdAt  DateTime @default(now())
  driver     Driver   @relation(fields: [driverId], references: [id])

  @@index([driverId])
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model EventPricing {
  id              String   @id @default(cuid())
  name            String
  startDate       String
  startTime       String
  endDate         String
  endTime         String
  increasePercent Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Bid {
  id        String   @id @default(cuid())
  bookingId String
  driverId  String
  bidTime   DateTime @default(now())
  isWinner  Boolean  @default(false)
  booking   Booking  @relation(fields: [bookingId], references: [id])
  driver    Driver   @relation(fields: [driverId], references: [id])

  @@index([bookingId])
  @@index([driverId])
}
